{
  "name": "texttrends-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@texttrends/standard-ebooks": "file:../standard_ebooks"
  },
  "scripts": {
    "dev": "pnpm --filter @texttrends/web dev",
    "build": "pnpm -r build",
    "test": "node --test 'scripts/*.test.mjs' && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @texttrends/web e2e",
    "update:se-catalog": "node scripts/update-se-catalog.mjs"
  }
}
