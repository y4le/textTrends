{
  "name": "texttrends-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@texttrends/standard-ebooks": "workspace:*",
    "fflate": "0.8.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "dev": "pnpm build:se && pnpm --filter @texttrends/web dev",
    "dev:tailnet": "pnpm build:se && bash scripts/dev-tailnet.sh",
    "build": "pnpm typecheck && pnpm --filter @texttrends/web build:bundle && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:se": "pnpm --filter @texttrends/standard-ebooks build",
    "test": "pnpm build:se && node --test 'scripts/*.test.mjs' && vitest run",
    "typecheck": "pnpm build:se && pnpm -r typecheck",
    "e2e": "pnpm --filter @texttrends/web e2e",
    "update:supplemental-corpus": "pnpm build:se && node scripts/update-supplemental-corpus.mjs",
    "update:stoplist": "node scripts/update-stoplist.mjs",
    "update:se-catalog": "pnpm build:se && node scripts/update-se-catalog.mjs",
    "update:austen-corpus": "pnpm build:se && node scripts/update-austen-corpus.mjs",
    "update:sherlock-corpus": "pnpm build:se && node scripts/update-sherlock-corpus.mjs",
    "update:demo-corpora": "pnpm build:se && node scripts/update-demo-corpora.mjs"
  }
}
