{
  "name": "@texttrends/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build:bundle",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:e2e": "pnpm --filter @texttrends/standard-ebooks build && vite build --mode e2e",
    "e2e": "playwright test --project=chromium-benchmark",
    "e2e:functional": "playwright test --project=chromium-functional",
    "e2e:bench": "playwright test --project=chromium-benchmark --no-deps"
  },
  "dependencies": {
    "@texttrends/core": "workspace:*",
    "@texttrends/extractors": "workspace:*",
    "@texttrends/standard-ebooks": "workspace:*",
    "fflate": "0.8.3",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
