{
  "name": "@texttrends/standard-ebooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-first Standard Ebooks catalog, download, and source-archive access.",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./archive": {
      "source": "./src/archive.ts",
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    }
  },
  "files": [
    "dist",
    "!dist/build.tsbuildinfo",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:live": "STANDARD_EBOOKS_LIVE_TEST=1 vitest run test/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@texttrends/epub": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
