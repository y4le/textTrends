{
  "name": "@texttrends/epub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, provider-neutral EPUB text and metadata extraction.",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "source": "./src/epub-reader.ts",
      "types": "./dist/epub-reader.d.ts",
      "import": "./dist/epub-reader.js"
    },
    "./markup-text": {
      "source": "./src/markup-text.ts",
      "types": "./dist/markup-text.d.ts",
      "import": "./dist/markup-text.js"
    }
  },
  "files": [
    "dist",
    "!dist/build.tsbuildinfo",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
